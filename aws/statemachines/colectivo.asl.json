{
  "Comment": "telecorp colectivo (Standard). Zona.UmbralSuperado -> crea la incidencia COLECTIVA y mueve sus reportes hijos. Antena.CambioEstado degradada -> incidencia proactiva ANT-<ulid> o correlación con el colectivo activo. Antena vuelve a NORMAL con toda la zona normal -> SOLUCIONADA.",
  "QueryLanguage": "JSONata",
  "StartAt": "Inicio",
  "States": {
    "Inicio": {
      "Type": "Pass",
      "Assign": {
        "evento": "{% $states.input.detail %}",
        "tipoEvento": "{% $states.input.`detail-type` %}",
        "eventoId": "{% $states.input.id ? $states.input.id : $states.context.Execution.Name %}"
      },
      "Next": "ElegirFlujo"
    },
    "ElegirFlujo": {
      "Type": "Choice",
      "Choices": [
        {
          "Comment": "Los marcadores ANT- los crea esta misma SFN (proactiva); su evento de umbral se ignora.",
          "Condition": "{% $tipoEvento = 'Zona.UmbralSuperado' and $exists($evento.incidenteColectivoId) and $substring($evento.incidenteColectivoId, 0, 4) != 'ANT-' %}",
          "Next": "BuscarColectivoExistente"
        },
        {
          "Condition": "{% $tipoEvento = 'Antena.CambioEstado' and $evento.estadoNuevo = 'NORMAL' %}",
          "Next": "ContarAntenasDegradadas"
        },
        {
          "Condition": "{% $tipoEvento = 'Antena.CambioEstado' and $exists($evento.estadoNuevo) %}",
          "Next": "LeerMarcador"
        }
      ],
      "Default": "SinAccion"
    },
    "BuscarColectivoExistente": {
      "Type": "Task",
      "Comment": "Idempotencia ante entregas duplicadas del evento.",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TablaIncidencias}",
        "Key": {
          "incidenciaId": {
            "S": "{% $evento.incidenteColectivoId %}"
          }
        },
        "ProjectionExpression": "incidenciaId",
        "ConsistentRead": true
      },
      "Assign": {
        "yaExiste": "{% $exists($states.result.Item) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "YaProcesado"
    },
    "YaProcesado": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $yaExiste %}",
          "Next": "SinAccion"
        }
      ],
      "Default": "LeerZonaColectivo"
    },
    "LeerZonaColectivo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TablaZonas}",
        "Key": {
          "zonaId": {
            "S": "{% $evento.zonaId %}"
          }
        },
        "ProjectionExpression": "zonaId, tipoZona"
      },
      "Assign": {
        "tipoZona": "{% $states.result.Item.tipoZona.S ? $states.result.Item.tipoZona.S : 'RESIDENCIAL' %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ConsultarAntenasZona"
    },
    "ConsultarAntenasZona": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Arguments": {
        "TableName": "${TablaAntenas}",
        "IndexName": "por-zona",
        "KeyConditionExpression": "zonaId = :z",
        "ExpressionAttributeNames": {
          "#e": "estado"
        },
        "ExpressionAttributeValues": {
          ":z": {
            "S": "{% $evento.zonaId %}"
          }
        },
        "ProjectionExpression": "antenaId, #e"
      },
      "Assign": {
        "antenas": "{% [$states.result.Items.{'antenaId': antenaId.S, 'estado': estado.S}] %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "LeerReportes"
    },
    "LeerReportes": {
      "Type": "Map",
      "Comment": "Descripción y tipo de cada reporte agrupado, para el resumen de la IA.",
      "Items": "{% [$evento.incidencias] %}",
      "ItemSelector": "{% $states.context.Map.Item.Value %}",
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "LeerReporte",
        "States": {
          "LeerReporte": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:getItem",
            "Arguments": {
              "TableName": "${TablaIncidencias}",
              "Key": {
                "incidenciaId": {
                  "S": "{% $states.input %}"
                }
              },
              "ProjectionExpression": "descripcion, tipo"
            },
            "Output": "{% {'descripcion': $states.result.Item.descripcion.S ? $states.result.Item.descripcion.S : '', 'tipo': $states.result.Item.tipo.S ? $states.result.Item.tipo.S : ''} %}",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          }
        }
      },
      "Assign": {
        "reportes": "{% $states.result %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "reportes": "{% [] %}"
          },
          "Next": "ResumirIA"
        }
      ],
      "Next": "ResumirIA"
    },
    "ResumirIA": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FuncionIA}",
        "Payload": {
          "accion": "RESUMIR_COLECTIVO",
          "incidenteColectivoId": "{% $evento.incidenteColectivoId %}",
          "zonaId": "{% $evento.zonaId %}",
          "tipoZona": "{% $tipoZona %}",
          "descripciones": "{% [$reportes.descripcion[$ != '']] %}",
          "antenas": "{% $antenas %}"
        }
      },
      "Assign": {
        "ia": "{% $states.result.Payload %}"
      },
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "ia": "{% {'resumen': 'Incidente colectivo en la zona ' & $evento.zonaId, 'severidad': 'ALTA'} %}"
          },
          "Next": "CrearColectiva"
        }
      ],
      "Next": "CrearColectiva"
    },
    "CrearColectiva": {
      "Type": "Task",
      "Comment": "Lambda auxiliar: prioridad (usuariosDistintos, tipoZona, severidad, antena degradada) + registrar_inicial() + transicionar() a EN_REVISION o ATENDIDA.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FuncionColectivo}",
        "Payload": {
          "accion": "CREAR_COLECTIVA",
          "incidenteColectivoId": "{% $evento.incidenteColectivoId %}",
          "zonaId": "{% $evento.zonaId %}",
          "tipoZona": "{% $tipoZona %}",
          "usuariosDistintos": "{% $evento.usuariosDistintos ? $evento.usuariosDistintos : $count($evento.incidencias) %}",
          "ventanaInicio": "{% $evento.ventanaInicio ? $evento.ventanaInicio : null %}",
          "ventanaFin": "{% $evento.ventanaFin ? $evento.ventanaFin : null %}",
          "incidencias": "{% [$evento.incidencias] %}",
          "antenas": "{% $antenas %}",
          "ia": "{% $ia %}",
          "tipos": "{% [$reportes.tipo[$ != '']] %}"
        }
      },
      "Assign": {
        "colectivoId": "{% $evento.incidenteColectivoId %}",
        "destino": "{% $states.result.Payload.destino %}",
        "comentario": "{% $states.result.Payload.comentario %}",
        "hijos": "{% [$evento.incidencias] %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "HayHijos"
    },
    "LeerMarcador": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TablaZonaVentana}",
        "Key": {
          "zonaId": {
            "S": "{% $evento.zonaId %}"
          },
          "sk": {
            "S": "COLECTIVO_ACTIVO"
          }
        },
        "ConsistentRead": true
      },
      "Assign": {
        "colectivoId": "{% $exists($states.result.Item.incidenteColectivoId.S) ? $states.result.Item.incidenteColectivoId.S : null %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "HayColectivoActivo"
    },
    "HayColectivoActivo": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $colectivoId != null %}",
          "Next": "AgregarAntena"
        }
      ],
      "Default": "CrearProactiva"
    },
    "CrearProactiva": {
      "Type": "Task",
      "Comment": "Reclama el marcador COLECTIVO_ACTIVO (attribute_not_exists) y crea ANT-<ulid> en ATENDIDA. Si otro colectivo ganó la carrera devuelve creada=false con su id.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FuncionColectivo}",
        "Payload": {
          "accion": "CREAR_PROACTIVA",
          "antenaId": "{% $evento.antenaId %}",
          "zonaId": "{% $evento.zonaId %}",
          "estadoAntena": "{% $evento.estadoNuevo %}",
          "ts": "{% $evento.ts ? $evento.ts : $states.context.Execution.StartTime %}",
          "eventoId": "{% $eventoId %}"
        }
      },
      "Assign": {
        "colectivoId": "{% $states.result.Payload.incidenciaId %}",
        "proactivaCreada": "{% $states.result.Payload.creada = true %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ProactivaCreada"
    },
    "ProactivaCreada": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $proactivaCreada %}",
          "Next": "Fin"
        }
      ],
      "Default": "AgregarAntena"
    },
    "AgregarAntena": {
      "Type": "Task",
      "Comment": "Agrega la antena a antenasAfectadas sin duplicarla. No es un cambio de estado. Solo si la incidencia ya existe.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${TablaIncidencias}",
        "Key": {
          "incidenciaId": {
            "S": "{% $colectivoId %}"
          }
        },
        "UpdateExpression": "SET antenasAfectadas = list_append(if_not_exists(antenasAfectadas, :vacia), :nueva)",
        "ConditionExpression": "attribute_exists(incidenciaId) AND NOT contains(antenasAfectadas, :aid)",
        "ExpressionAttributeValues": {
          ":vacia": {
            "L": []
          },
          ":nueva": {
            "L": [
              {
                "S": "{% $evento.antenaId %}"
              }
            ]
          },
          ":aid": {
            "S": "{% $evento.antenaId %}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.InternalServerErrorException",
            "DynamoDB.AmazonDynamoDBException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "Next": "EscalarColectivo"
        }
      ],
      "Next": "EscalarColectivo"
    },
    "EscalarColectivo": {
      "Type": "Task",
      "Comment": "Si el colectivo estaba EN_REVISION, la antena lo confirma: pasa a ATENDIDA y devuelve sus hijos.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FuncionColectivo}",
        "Payload": {
          "accion": "ESCALAR",
          "incidenciaId": "{% $colectivoId %}",
          "antenaId": "{% $evento.antenaId %}"
        }
      },
      "Assign": {
        "destino": "{% $states.result.Payload.destino ? $states.result.Payload.destino : 'ATENDIDA' %}",
        "comentario": "{% $states.result.Payload.comentario ? $states.result.Payload.comentario : 'Incidencia identificada' %}",
        "hijos": "{% [$states.result.Payload.hijos] %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "HayHijos"
    },
    "ContarAntenasDegradadas": {
      "Type": "Task",
      "Comment": "Excluye la antena del evento por si el GSI aún no refleja su vuelta a NORMAL.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Arguments": {
        "TableName": "${TablaAntenas}",
        "IndexName": "por-zona",
        "KeyConditionExpression": "zonaId = :z",
        "FilterExpression": "#e <> :normal",
        "ExpressionAttributeNames": {
          "#e": "estado"
        },
        "ExpressionAttributeValues": {
          ":z": {
            "S": "{% $evento.zonaId %}"
          },
          ":normal": {
            "S": "NORMAL"
          }
        },
        "ProjectionExpression": "antenaId"
      },
      "Assign": {
        "degradadas": "{% $count($states.result.Items[antenaId.S != $evento.antenaId]) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ZonaNormal"
    },
    "ZonaNormal": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $degradadas = 0 %}",
          "Next": "LeerMarcadorRestablecer"
        }
      ],
      "Default": "SinAccion"
    },
    "LeerMarcadorRestablecer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TablaZonaVentana}",
        "Key": {
          "zonaId": {
            "S": "{% $evento.zonaId %}"
          },
          "sk": {
            "S": "COLECTIVO_ACTIVO"
          }
        },
        "ConsistentRead": true
      },
      "Assign": {
        "colectivoId": "{% $exists($states.result.Item.incidenteColectivoId.S) ? $states.result.Item.incidenteColectivoId.S : null %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "HayColectivoParaRestablecer"
    },
    "HayColectivoParaRestablecer": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $colectivoId != null %}",
          "Next": "Restablecer"
        }
      ],
      "Default": "SinAccion"
    },
    "Restablecer": {
      "Type": "Task",
      "Comment": "Pasa el colectivo (con antenas correlacionadas) a SOLUCIONADA, borra el marcador y devuelve sus hijos.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FuncionColectivo}",
        "Payload": {
          "accion": "RESTABLECER",
          "incidenciaId": "{% $colectivoId %}",
          "zonaId": "{% $evento.zonaId %}"
        }
      },
      "Assign": {
        "destino": "SOLUCIONADA",
        "comentario": "Servicio restablecido",
        "hijos": "{% [$states.result.Payload.hijos] %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "HayHijos"
    },
    "HayHijos": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($hijos) > 0 %}",
          "Next": "MoverHijos"
        }
      ],
      "Default": "Fin"
    },
    "MoverHijos": {
      "Type": "Map",
      "Comment": "Cada reporte hijo sigue al colectivo; las transiciones inválidas se ignoran en la Lambda y cada hijo notifica por ciclo-vida.",
      "Items": "{% $hijos %}",
      "ItemSelector": "{% {'accion': 'MOVER_HIJO', 'incidenciaId': $states.context.Map.Item.Value, 'destino': $destino, 'incidenteColectivoId': $colectivoId, 'comentario': $comentario} %}",
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "MoverHijo",
        "States": {
          "MoverHijo": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${FuncionColectivo}",
              "Payload": "{% $states.input %}"
            },
            "Output": "{% {'incidenciaId': $states.result.Payload.incidenciaId, 'transicionado': $states.result.Payload.transicionado} %}",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              },
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": "{% {'incidenciaId': $states.input.incidenciaId, 'transicionado': false, 'error': $states.errorOutput.Error} %}",
                "Next": "HijoFallido"
              }
            ],
            "End": true
          },
          "HijoFallido": {
            "Type": "Pass",
            "End": true
          }
        }
      },
      "Output": "{% {'colectivoId': $colectivoId, 'destino': $destino, 'hijos': $count($states.result), 'movidos': $count($states.result[transicionado = true])} %}",
      "End": true
    },
    "Fin": {
      "Type": "Succeed",
      "Output": "{% {'colectivoId': $colectivoId} %}"
    },
    "SinAccion": {
      "Type": "Succeed",
      "Output": "{% {'accion': 'NINGUNA', 'tipoEvento': $tipoEvento} %}"
    }
  }
}
